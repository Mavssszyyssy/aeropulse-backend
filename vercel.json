{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index?__route=:route*"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
