PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aeropulse
# Optional Atlas SRV DNS fallback. Use only when mongodb+srv DNS lookups fail.
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://your-web-app.vercel.app
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=https://your-backend.vercel.app
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE_URL=https://api.paymongo.com
