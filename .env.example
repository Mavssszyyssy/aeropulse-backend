PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aeropulse
# Optional Atlas SRV DNS fallback. Use only when mongodb+srv DNS lookups fail.
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://your-web-app.vercel.app
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=https://your-backend.vercel.app
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE_URL=https://api.paymongo.com

# Infobip SMS OTP. In a trial account, INFOBIP_SENDER must be ServiceSMS and
# messages can only go to phone numbers verified in your Infobip account.
# Copy the Base URL shown in Infobip's Developer Tools without https://.
INFOBIP_API_KEY=PASTE_AN_API_KEY_WITH_SMS_MESSAGE_SEND_SCOPE
# Optional but recommended: dedicated Email API key. Add email:message:send,
# message:send, or email:manage when creating this key in Infobip.
INFOBIP_EMAIL_API_KEY=PASTE_AN_API_KEY_WITH_EMAIL_SEND_SCOPE
INFOBIP_BASE_URL=YOUR_ACCOUNT.api.infobip.com
INFOBIP_SENDER=ServiceSMS
# Verify this sender/domain in Infobip before using email OTP.
INFOBIP_EMAIL_SENDER=no-reply@YOUR_VERIFIED_DOMAIN.com
